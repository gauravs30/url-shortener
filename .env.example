# Copy to .env for docker compose. `.env` is git-ignored.

# Inside compose, the DB host is the `db` service name.
DATABASE_URL=postgresql+asyncpg://shortener:shortener@db:5432/shortener

# Public origin used to build the short URLs handed back to clients (no trailing slash).
BASE_URL=http://localhost:8000

SHORT_CODE_LENGTH=7
RATE_LIMIT=20/minute

# Mixed into the SHA-256 of each visitor IP before it is stored. Change this.
IP_HASH_SALT=please-change-this
